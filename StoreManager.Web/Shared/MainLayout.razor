@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.Storefront" Class="mr-2" />
        <MudText Typo="Typo.h6">StoreManager</MudText>
        <MudSpacer />
        @if (_currentUser is not null)
        {
            <MudText Typo="Typo.body2" Class="mr-2">
                @_currentUser.Name <MudText Typo="Typo.caption" Class="mud-text-secondary" Inline="true">(@_currentUser.Role)</MudText>
            </MudText>
            <MudTooltip Text="Logout">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
            </MudTooltip>
        }
        <MudTooltip Text="Toggle light / dark">
            <MudIconButton Icon="@DarkLightModeIcon" Color="Color.Inherit" OnClick="ToggleDarkMode" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
               Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pb-0">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Summer Camp · Module 2</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private UserDto? _currentUser;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#00897B",
            Secondary = "#FB8C00",
            AppbarBackground = "#00897B",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#26A69A",
            Secondary = "#FFB74D",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
        },
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private string DarkLightModeIcon =>
        _isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnChange += HandleAuthStateChanged;
        _currentUser = await AuthService.GetCurrentUserAsync();
    }

    private async void HandleAuthStateChanged()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthService.OnChange -= HandleAuthStateChanged;
    }
}
